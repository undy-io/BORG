{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": { "type": "string" }
      },
      "required": ["repository"]
    },

    "authKeySecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "name": { "type": "string" },
        "key":  {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "description": "EMPTY or a padded/unpadded base64url value that decodes to 32 bytes",
          "oneOf": [
            { "enum": ["", "EMPTY"] },
            { "pattern": "^[A-Za-z0-9_-]{43}=?$" }
          ]
        }
      },
      "required": ["name", "key"],
      "anyOf": [
        {
          "properties": { "existingSecret": { "minLength": 1 } },
          "required": ["existingSecret"]
        },
        {
          "properties": { "name": { "minLength": 1 } },
          "required": ["name"]
        }
      ]
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      },
      "required": ["create", "name"]
    },

    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "clusterScoped": { "type": "boolean" },
        "namespaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extraRules": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["create", "clusterScoped", "namespaces", "extraRules"]
    },

    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },

    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },

    "resources": {
      "type": "object",
      "additionalProperties": true
    },

    "apikeySecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["create", "existingSecret", "name"],
      "anyOf": [
        {
          "properties": { "existingSecret": { "minLength": 1 } },
          "required": ["existingSecret"]
        },
        {
          "properties": { "name": { "minLength": 1 } },
          "required": ["name"]
        }
      ]
    },

    "config": {
      "type": "object",
      "description": "Proxy runtime configuration",
      "additionalProperties": false,
      "properties": {
        "auth_prefix": { "type": "string" },
        "update_interval": { "type": "integer" },
        "max_request_body_bytes": { "type": "integer", "minimum": 0 },
        "backend_health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "failure_threshold": { "type": "integer", "minimum": 1 },
            "cooldown_seconds": { "type": "integer", "minimum": 1 },
            "eject_on_500": { "type": "boolean" }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "response_header_timeout_seconds": { "type": "integer", "minimum": 0 }
          },
          "required": ["response_header_timeout_seconds"]
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpoint": { "type": "string", "minLength": 1 },
              "apikey": { "type": "string" },
              "apikeyEnv": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "models": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["endpoint", "models"],
            "allOf": [
              {
                "if": {
                  "properties": { "apikey": { "minLength": 1 } },
                  "required": ["apikey"]
                },
                "then": { "required": ["apikeyEnv"] }
              }
            ]
          }
        },
        "k8s_discover": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "not": { "const": "static" } },
              "namespace": { "type": "string" },
              "selector": { "type": "string" },
              "modelkey": { "type": "string" }
            }
          }
        },
        "k8s_service_discover": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "not": { "const": "static" } },
              "namespace": { "type": "string" },
              "service_name": { "type": "string", "minLength": 1 },
              "selector": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "port_name": { "type": "string", "minLength": 1 },
              "protocol": { "type": "string", "enum": ["http", "https"] },
              "api_base": { "type": "string", "pattern": "^/" },
              "models": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "modelkey": { "type": "string" },
              "automodel": { "type": "boolean" },
              "models_path": { "type": "string", "pattern": "^/" },
              "apikey": { "type": "string" },
              "apikeyEnv": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": ["id"],
            "oneOf": [
              { "required": ["service_name"], "not": { "required": ["selector"] } },
              { "required": ["selector"], "not": { "required": ["service_name"] } }
            ],
            "not": { "required": ["port", "port_name"] },
            "allOf": [
              {
                "if": {
                  "properties": { "apikey": { "minLength": 1 } },
                  "required": ["apikey"]
                },
                "then": { "required": ["apikeyEnv"] }
              }
            ]
          }
        }
      },
      "required": ["auth_prefix", "update_interval", "max_request_body_bytes", "backend_health", "upstream", "instances", "k8s_discover", "k8s_service_discover"]
    },

    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "mountPath": { "type": "string" },
            "certKey": { "type": "string" },
            "privateKeyKey": { "type": "string" }
          },
          "required": ["enabled", "mountPath", "certKey", "privateKeyKey"]
        }
      },
      "required": ["tls"]
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": ["Cluster", "Local"]
        },
        "port":       { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["port"]
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "enabled":   { "type": "boolean" },
        "className": { "type": "string" },

        "annotations": {
          "type": "object",
          "description": "Extra annotations on the Ingress",
          "additionalProperties": { "type": "string" }
        },

        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name":  { "type": "string" },
            "kind":  { "type": "string", "enum": ["Issuer", "ClusterIssuer"] },
            "scope": { "type": "string", "enum": ["namespaced", "cluster"] },

            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },

            "cert": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },

                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "commonName":          { "type": "string", "optional": true },
                    "organizations":       { "type": "array", "items": { "type": "string" } },
                    "organizationalUnits": { "type": "array", "items": { "type": "string" } },
                    "countries":           { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 2 } },
                    "localities":          { "type": "array", "items": { "type": "string" } },
                    "provinces":           { "type": "array", "items": { "type": "string" } }
                  }
                },

                "altNames": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "required": ["name"]
        },

        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host":  { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },

              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path":     { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  },
                  "required": ["path", "pathType"]
                }
              }
            },
            "required": ["host"]
          }
        },

        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },

            "secretName": {
              "type": "string",
              "description": "Override for the TLS secret (<release>-tls by default)"
            },

            "existingSecret": {
              "type": ["string", "null"],
              "description": "Reference to a pre-created secret"
            }
          }
        }
      },

      "required": ["enabled", "hosts"]
    },

    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "secretName": { "type": "string" },
        "commonName": { "type": "string" },
        "dnsNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "altNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ipAddresses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "uris": {
          "type": "array",
          "items": { "type": "string" }
        },
        "emailAddresses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string" },
            "group": { "type": "string" }
          }
        },
        "usages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organizations":       { "type": "array", "items": { "type": "string" } },
            "organizationalUnits": { "type": "array", "items": { "type": "string" } },
            "countries":           { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 2 } },
            "localities":          { "type": "array", "items": { "type": "string" } },
            "provinces":           { "type": "array", "items": { "type": "string" } },
            "streetAddresses":     { "type": "array", "items": { "type": "string" } },
            "postalCodes":         { "type": "array", "items": { "type": "string" } },
            "serialNumber":        { "type": "string" }
          }
        }
      }
    }
  }
}
